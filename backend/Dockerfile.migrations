FROM node:22-alpine
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.json ./
COPY backend ./backend
RUN test -f backend/scripts/migrate.ts && test -d backend/migrations
USER node
CMD ["pnpm","run","db:migrate"]
