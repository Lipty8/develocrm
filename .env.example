# Frontend / Sites – pouze veřejná konfigurace, nikdy secrets
DEVELOCRM_DATA_MODE=api
DEVELOCRM_API_URL=https://<backend-container-app-fqdn>
DEVELOCRM_TENANT_ID=<workspace-uuid>
DEVELOCRM_ENTRA_CLIENT_ID=<frontend-spa-client-id>
DEVELOCRM_ENTRA_TENANT_ID=<entra-tenant-id>
DEVELOCRM_ENTRA_AUTHORITY=https://login.microsoftonline.com/<entra-tenant-id>
DEVELOCRM_API_SCOPE=api://<backend-api-client-id>/access_as_user
DEVELOCRM_FRONTEND_ORIGIN=https://<pilot-frontend-host>
DEVELOCRM_ENTRA_REDIRECT_URI=https://<pilot-frontend-host>/dashboard
DEVELOCRM_ENTRA_POST_LOGOUT_REDIRECT_URI=https://<pilot-frontend-host>
